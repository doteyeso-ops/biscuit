# Copy to .env and edit. Every value here has a working default except the
# token: leave it unset and the dashboard is open to your network.

# --- where it listens -------------------------------------------------------
DOT_PORT=8767
# Shared secret for /ui and the JSON API. The device sockets stay open.
# Set it if the machine is on a network you do not own.
# DOT_UI_TOKEN=change-me

# --- the brain --------------------------------------------------------------
# Any OpenAI-compatible endpoint. If unset, the controller tries the hermes
# CLI, then falls back to local answers (time, date) with no model at all.
# DOT_LLM_URL=http://127.0.0.1:1234/v1
# DOT_LLM_MODEL=gpt-4o-mini
# DOT_LLM_KEY=sk-...

# --- no device, no problem --------------------------------------------------
# Fake device: the dashboard, ring logic and music pipeline run, audio goes
# nowhere. Same as passing --simulate.
# DOT_SIMULATE=1

# --- voice ------------------------------------------------------------------
# 1 = keep listening for a follow-up after answering (the mic hears the room)
VOICE_FOLLOWUPS=0
# TTS_VOICE=Microsoft Zira Desktop

# --- music ------------------------------------------------------------------
# MUSIC_GAIN_DB=0
# QUICK_SEARCH_TIMEOUT=2.5

# --- the Google lane --------------------------------------------------------
# Needs a Chromium started with --remote-debugging-port=9222
# DOT_DISABLE_GOOGLE=1
